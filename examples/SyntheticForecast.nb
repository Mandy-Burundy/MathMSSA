(* Content-type: application/vnd.wolfram.mathematica *)

(* Beginning of Notebook Content *)
Notebook[{
Cell["MathMSSA on synthetic series", "Title"],
Cell["Evaluate the input cells from the top. The four series have a known next value, so the absolute difference is the check.", "Text"],
Cell[BoxData[{
RowBox[{"(*", " ", " Kernel/MathMSSA.wl sits in the Kernel directory of this package. ", " ", "*)"}], "\[IndentingNewLine]",
RowBox[{"(*", " ", " One call is one window. Requested ranks of that window share one SVD. ", " ", "*)"}], "\[IndentingNewLine]",
RowBox[{RowBox[{"$HistoryLength", "=", "0"}], ";", RowBox[{"kernel", "=", RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[{RowBox[{"ParentDirectory", "[", RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ",", "\"Kernel\"", ",", "\"MathMSSA.wl\""}], "}"}], "]"}]}], ";", RowBox[{"Get", "[", "kernel", "]"}], ";", RowBox[{"MathMSSA`$MathMSSALogging", "=", "False"}], ";"}]
}], "Input"],
Cell[BoxData[{
RowBox[{"(*", " ", " y has length N. Each auxiliary has length N + 1, and its last sample is known at the forecast time. ", " ", "*)"}], "\[IndentingNewLine]",
RowBox[{"(*", " ", " X is that auxiliary block transposed, with shape (N + 1) by d. ", " ", "*)"}], "\[IndentingNewLine]",
RowBox[{"(*", " ", " Time starts at 1, so the forecast is the target value at time N + 1. ", " ", "*)"}], "\[IndentingNewLine]",
RowBox[{"(*", " ", " A constant continues at rank 1, a line at rank 2, one sine at rank 2, and a line plus a sine at rank 4. ", " ", "*)"}], "\[IndentingNewLine]",
RowBox[{RowBox[{"period", "=", "17.`"}], ";", RowBox[{"n", "=", "128"}], ";", RowBox[{"window", "=", "40"}], ";", RowBox[{RowBox[{"line", "[", RowBox[{"a_", ",", "b_", ",", "len_Integer"}], "]"}], ":=", RowBox[{"a", "+", RowBox[{"b", " ", RowBox[{"Range", "[", "len", "]"}]}]}]}], ";", RowBox[{RowBox[{"tone", "[", RowBox[{"amp_", ",", "phase_", ",", "len_Integer"}], "]"}], ":=", RowBox[{"amp", " ", RowBox[{"Sin", "[", RowBox[{FractionBox[RowBox[{"2.`", " ", "\[Pi]", " ", RowBox[{"Range", "[", "len", "]"}]}], "period"], "+", "phase"}], "]"}]}]}], ";", RowBox[{"series", "=", RowBox[{"Association", "[", RowBox[{RowBox[{"\"CONST\"", "\[Rule]", RowBox[{"Association", "[", RowBox[{RowBox[{"\"channels\"", "\[Rule]", RowBox[{"{", RowBox[{RowBox[{"ConstantArray", "[", RowBox[{"2.5`", ",", "n"}], "]"}], ",", RowBox[{"ConstantArray", "[", RowBox[{RowBox[{"-", "1.25`"}], ",", RowBox[{"n", "+", "1"}]}], "]"}], ",", RowBox[{"ConstantArray", "[", RowBox[{"4.`", ",", RowBox[{"n", "+", "1"}]}], "]"}]}], "}"}]}], ",", RowBox[{"\"ranks\"", "\[Rule]", RowBox[{"{", "1", "}"}]}], ",", RowBox[{"\"expected\"", "\[Rule]", "2.5`"}]}], "]"}]}], ",", RowBox[{"\"LINEAR\"", "\[Rule]", RowBox[{"Association", "[", RowBox[{RowBox[{"\"channels\"", "\[Rule]", RowBox[{"{", RowBox[{RowBox[{"line", "[", RowBox[{"0.3`", ",", "0.05`", ",", "n"}], "]"}], ",", RowBox[{"line", "[", RowBox[{RowBox[{"-", "1.`"}], ",", "0.02`", ",", RowBox[{"n", "+", "1"}]}], "]"}], ",", RowBox[{"line", "[", RowBox[{"1.5`", ",", RowBox[{"-", "0.01`"}], ",", RowBox[{"n", "+", "1"}]}], "]"}]}], "}"}]}], ",", RowBox[{"\"ranks\"", "\[Rule]", RowBox[{"{", "2", "}"}]}], ",", RowBox[{"\"expected\"", "\[Rule]", RowBox[{RowBox[{"0.3`", " "}], "+", RowBox[{"0.05`", " ", RowBox[{"(", RowBox[{"n", "+", "1"}], ")"}]}]}]}]}], "]"}]}], ",", RowBox[{"\"HARMONIC\"", "\[Rule]", RowBox[{"Association", "[", RowBox[{RowBox[{"\"channels\"", "\[Rule]", RowBox[{"{", RowBox[{RowBox[{"tone", "[", RowBox[{"1.`", ",", "0.`", ",", "n"}], "]"}], ",", RowBox[{"tone", "[", RowBox[{"0.7`", ",", "0.4`", ",", RowBox[{"n", "+", "1"}]}], "]"}], ",", RowBox[{"tone", "[", RowBox[{"1.3`", ",", RowBox[{"-", "0.8`"}], ",", RowBox[{"n", "+", "1"}]}], "]"}]}], "}"}]}], ",", RowBox[{"\"ranks\"", "\[Rule]", RowBox[{"{", "2", "}"}]}], ",", RowBox[{"\"expected\"", "\[Rule]", RowBox[{"Sin", "[", FractionBox[RowBox[{"2.`", " ", "\[Pi]", " ", RowBox[{"(", RowBox[{"n", "+", "1"}], ")"}]}], "period"], "]"}]}]}], "]"}]}], ",", RowBox[{"\"TREND_HARMONIC\"", "\[Rule]", RowBox[{"Association", "[", RowBox[{RowBox[{"\"channels\"", "\[Rule]", RowBox[{"{", RowBox[{RowBox[{RowBox[{"line", "[", RowBox[{"0.2`", ",", "0.01`", ",", "n"}], "]"}], "+", RowBox[{"tone", "[", RowBox[{"0.5`", ",", "0.`", ",", "n"}], "]"}]}], ",", RowBox[{RowBox[{"line", "[", RowBox[{RowBox[{"-", "0.4`"}], ",", "0.03`", ",", RowBox[{"n", "+", "1"}]}], "]"}], "+", RowBox[{"tone", "[", RowBox[{"0.8`", ",", "0.5`", ",", RowBox[{"n", "+", "1"}]}], "]"}]}], ",", RowBox[{RowBox[{"line", "[", RowBox[{"0.6`", ",", RowBox[{"-", "0.02`"}], ",", RowBox[{"n", "+", "1"}]}], "]"}], "+", RowBox[{"tone", "[", RowBox[{"0.4`", ",", RowBox[{"-", "0.3`"}], ",", RowBox[{"n", "+", "1"}]}], "]"}]}]}], "}"}]}], ",", RowBox[{"\"ranks\"", "\[Rule]", RowBox[{"{", "4", "}"}]}], ",", RowBox[{"\"expected\"", "\[Rule]", RowBox[{RowBox[{"0.2`", " "}], "+", RowBox[{"0.01`", " ", RowBox[{"(", RowBox[{"n", "+", "1"}], ")"}]}], "+", RowBox[{"0.5`", " ", RowBox[{"Sin", "[", FractionBox[RowBox[{"2.`", " ", "\[Pi]", " ", RowBox[{"(", RowBox[{"n", "+", "1"}], ")"}]}], "period"], "]"}]}]}]}]}], "]"}]}]}], "]"}]}], ";"}]
}], "Input"],
Cell[BoxData[{
RowBox[{"(*", " ", " The first channel is y. Transpose of the remaining channels stacks the auxiliaries as columns of X. ", " ", "*)"}], "\[IndentingNewLine]",
RowBox[{"(*", " ", " ForecastH is the target component of the one-step row forecast. ", " ", "*)"}], "\[IndentingNewLine]",
RowBox[{RowBox[{RowBox[{"forecastRow", "[", RowBox[{"name_String", ",", "spec_Association"}], "]"}], ":=", RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{"y", ",", "x", ",", "result", ",", "rank", ",", "forecast"}], "}"}], ",", RowBox[{RowBox[{"y", "=", RowBox[{"N", "[", RowBox[{"First", "[", RowBox[{"spec", "[", "\"channels\"", "]"}], "]"}], "]"}]}], ";", RowBox[{"x", "=", RowBox[{"N", "[", RowBox[{"Transpose", "[", RowBox[{"Rest", "[", RowBox[{"spec", "[", "\"channels\"", "]"}], "]"}], "]"}], "]"}]}], ";", RowBox[{"result", "=", RowBox[{"MathMSSA`MathMSSA", "[", RowBox[{"y", ",", "x", ",", "window", ",", RowBox[{"spec", "[", "\"ranks\"", "]"}]}], "]"}]}], ";", RowBox[{"rank", "=", RowBox[{"Last", "[", RowBox[{"spec", "[", "\"ranks\"", "]"}], "]"}]}], ";", RowBox[{"forecast", "=", RowBox[{RowBox[{RowBox[{"result", "[", "\"ByRank\"", "]"}], "[", "rank", "]"}], "[", "\"ForecastH\"", "]"}]}], ";", RowBox[{"Association", "[", RowBox[{RowBox[{"\"Case\"", "\[Rule]", "name"}], ",", RowBox[{"\"L\"", "\[Rule]", "window"}], ",", RowBox[{"\"Rank\"", "\[Rule]", "rank"}], ",", RowBox[{"\"ForecastH\"", "\[Rule]", "forecast"}], ",", RowBox[{"\"Expected\"", "\[Rule]", RowBox[{"spec", "[", "\"expected\"", "]"}]}], ",", RowBox[{"\"AbsDiff\"", "\[Rule]", RowBox[{"Abs", "[", RowBox[{"forecast", "-", RowBox[{"spec", "[", "\"expected\"", "]"}]}], "]"}]}]}], "]"}]}]}], "]"}]}], ";", RowBox[{"rows", "=", RowBox[{"KeyValueMap", "[", RowBox[{"forecastRow", ",", "series"}], "]"}]}], ";", RowBox[{"Association", "[", RowBox[{RowBox[{"\"Rows\"", "\[Rule]", RowBox[{"Dataset", "[", "rows", "]"}]}], ",", RowBox[{"\"MaxAbsDiff\"", "\[Rule]", RowBox[{"Max", "[", RowBox[{"rows", "\[LeftDoubleBracket]", RowBox[{"All", ",", "\"AbsDiff\""}], "\[RightDoubleBracket]"}], "]"}]}]}], "]"}]}]
}], "Input"],
Cell[BoxData[{
RowBox[{"(*", " ", " Rank 2 keeps only part of a line plus a sine. Rank 4 is the continuation of that series. ", " ", "*)"}], "\[IndentingNewLine]",
RowBox[{"(*", " ", " Both forecasts come from one call and one truncated SVD. ", " ", "*)"}], "\[IndentingNewLine]",
RowBox[{RowBox[{"spec", "=", RowBox[{"series", "[", "\"TREND_HARMONIC\"", "]"}]}], ";", RowBox[{"y", "=", RowBox[{"N", "[", RowBox[{"First", "[", RowBox[{"spec", "[", "\"channels\"", "]"}], "]"}], "]"}]}], ";", RowBox[{"x", "=", RowBox[{"N", "[", RowBox[{"Transpose", "[", RowBox[{"Rest", "[", RowBox[{"spec", "[", "\"channels\"", "]"}], "]"}], "]"}], "]"}]}], ";", RowBox[{"both", "=", RowBox[{"MathMSSA`MathMSSA", "[", RowBox[{"y", ",", "x", ",", "window", ",", RowBox[{"{", RowBox[{"2", ",", "4"}], "}"}]}], "]"}]}], ";", RowBox[{"Association", "[", RowBox[{RowBox[{"\"SingularValues\"", "\[Rule]", RowBox[{RowBox[{"both", "[", "\"Decomposition\"", "]"}], "[", "\"MSSASingularValues\"", "]"}]}], ",", RowBox[{"\"ForecastRank2\"", "\[Rule]", RowBox[{RowBox[{RowBox[{"both", "[", "\"ByRank\"", "]"}], "[", "2", "]"}], "[", "\"ForecastH\"", "]"}]}], ",", RowBox[{"\"ForecastRank4\"", "\[Rule]", RowBox[{RowBox[{RowBox[{"both", "[", "\"ByRank\"", "]"}], "[", "4", "]"}], "[", "\"ForecastH\"", "]"}]}], ",", RowBox[{"\"Expected\"", "\[Rule]", RowBox[{"spec", "[", "\"expected\"", "]"}]}], ",", RowBox[{"\"AbsDiffRank4\"", "\[Rule]", RowBox[{"Abs", "[", RowBox[{RowBox[{RowBox[{RowBox[{"both", "[", "\"ByRank\"", "]"}], "[", "4", "]"}], "[", "\"ForecastH\"", "]"}], "-", RowBox[{"spec", "[", "\"expected\"", "]"}]}], "]"}]}]}], "]"}]}]
}], "Input"]
}, WindowTitle -> "MathMSSA synthetic", WindowSize -> {920, 780}]
(* End of Notebook Content *)
